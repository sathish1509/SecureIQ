# Production Dockerfile for SecureIQ Python Flask Backend API & ML Service
FROM python:3.10-slim

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=5000 \
    CORS_ORIGINS="*" \
    DATABASE_PATH="/app/scans.db"

WORKDIR /app

# Install system dependencies required for WHOIS network lookups & SSL certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend source code, database module, threat intel module, email analyzer, auth module & pre-trained scikit-learn models
COPY app.py ./
COPY database.py ./
COPY feature_extractor.py ./
COPY threat_intel.py ./
COPY email_analyzer.py ./
COPY auth.py ./
COPY Model/ ./Model/

# Expose backend API port
EXPOSE 5000

# Container health check monitoring endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Launch production multi-worker Gunicorn WSGI HTTP server
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--threads", "2", "--timeout", "60", "app:app"]
